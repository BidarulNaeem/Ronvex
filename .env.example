# RONVEX E-Commerce Platform Environment Variables

# APP_URL: The URL where this applet is hosted.
APP_URL="https://ronvex.vercel.app"

# PORT: Server listening port (default: 3000)
PORT=3000

# SUPABASE CONFIGURATION (For optional direct Supabase PostgreSQL deployment)
# See /supabase_schema.sql for the complete database schema and RLS policies
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
